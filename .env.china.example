# Set these variables on the China GPU server. Do not commit the real values.
WEBVIEWER_GATEWAY_URL=https://viewer.example.com
WEBVIEWER_WORKER_TOKEN=must-match-the-singapore-token
WEBVIEWER_WORKER_ID=china-gpu-01
WEBVIEWER_WORKER_DATA_DIR=D:\MXZY-AI-worker-data
WEBVIEWER_WORKER_POLL_SECONDS=10
WEBVIEWER_WORKER_HEARTBEAT_SECONDS=30
WEBVIEWER_VERIFY_TLS=true

# Keep gated model credentials only on the China inference server.
HF_TOKEN=replace-with-the-approved-huggingface-token
