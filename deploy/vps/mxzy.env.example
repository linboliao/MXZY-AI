# Copy to /etc/caddy/mxzy.env on the overseas VPS.
# DNS for this domain must point to the VPS public IP.
MXZY_PUBLIC_DOMAIN=ai.example.com
MXZY_ACME_EMAIL=admin@example.com

# Public HTTP Basic Authentication credentials.
MXZY_BASIC_AUTH_USER=mxzy
MXZY_BASIC_AUTH_HASH=replace-with-output-of-caddy-hash-password

# XMU GPU server's Tailscale IPv4 address and private Web Viewer port.
MXZY_CAMPUS_UPSTREAM=http://100.64.0.20:5000
