# MXZY-AI all-in-one deployment on the XMU GPU server.
# Copy this file to /etc/mxzy-ai/campus-server-ui.env and replace every
# replace-* value. Never commit the real environment file.

# Bind only to this server's Tailscale IPv4 address (`tailscale ip -4`).
# The overseas VPS reaches this address through the private tailnet.
WEBVIEWER_HOST=100.64.0.20
WEBVIEWER_PORT=5000
WEBVIEWER_SERVER=waitress
WEBVIEWER_SERVER_THREADS=8

# Store uploads and generated results on a large, access-controlled disk.
WEBVIEWER_DATA_DIR=/data/mxzy-ai-ui
WEBVIEWER_MAX_UPLOAD_GB=20
WEBVIEWER_RESULT_BUNDLE_MAX_MB=512
WEBVIEWER_SLIDE_CACHE_SIZE=4
# Optional: expose existing server-side slide folders without uploading them.
# Separate multiple NAME=PATH entries with semicolons.
# WEBVIEWER_SERVER_SLIDE_ROOTS=pathology=/data/pathology;archive=/data/archive

# Run the medical image pipeline directly on this GPU server.
WEBVIEWER_PIPELINE_MODE=real
WEBVIEWER_EXECUTION_BACKEND=local
WEBVIEWER_PIPELINE_MODEL=h-optimus-1
WEBVIEWER_PIPELINE_NORMAL=true
WEBVIEWER_SYNC_JOBS=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBVIEWER_SECRET_KEY=replace-with-a-long-random-secret

# Required unless bioptimus/H-optimus-1 is already cached for the service user.
HF_TOKEN=replace-with-the-approved-huggingface-token
