# Copy to .env.campus-worker.local on the XMU GPU server.
# This must point to the Windows UI computer's Tailscale IP, not 172.27.127.195.
WEBVIEWER_GATEWAY_URL=http://100.64.0.10:5000
WEBVIEWER_WORKER_TOKEN=must-match-the-local-ui-token
WEBVIEWER_WORKER_ID=xmu-gpu-172-27-127-195
WEBVIEWER_WORKER_DATA_DIR=/data/mxzy-ai-worker
WEBVIEWER_WORKER_POLL_SECONDS=10
WEBVIEWER_WORKER_HEARTBEAT_SECONDS=30
WEBVIEWER_VERIFY_TLS=true

# Required when H-optimus-1 is not already present in the server cache.
HF_TOKEN=replace-with-the-approved-huggingface-token
