# Copy to .env.local-ui.local on the Windows UI computer.
# Replace this address with the UI computer's `tailscale ip -4` result.
WEBVIEWER_HOST=100.64.0.10
WEBVIEWER_PORT=5000
WEBVIEWER_SERVER=waitress
WEBVIEWER_SERVER_THREADS=8
WEBVIEWER_DATA_DIR=D:\MXZY-AI-ui-data
WEBVIEWER_MAX_UPLOAD_GB=20
WEBVIEWER_SECRET_KEY=replace-with-a-long-random-secret
WEBVIEWER_PIPELINE_MODE=real
WEBVIEWER_EXECUTION_BACKEND=remote
WEBVIEWER_PIPELINE_MODEL=h-optimus-1
WEBVIEWER_PIPELINE_NORMAL=true
WEBVIEWER_WORKER_TOKEN=replace-with-a-separate-long-random-token
WEBVIEWER_WORKER_LEASE_SECONDS=300
WEBVIEWER_RESULT_BUNDLE_MAX_MB=512
WEBVIEWER_SLIDE_CACHE_SIZE=4
